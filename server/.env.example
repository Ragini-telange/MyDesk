# Server Port
PORT=5000

# MongoDB Connection String
# Local MongoDB example: mongodb://localhost:27017/mydesk
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster.mongodb.net/mydesk?retryWrites=true&w=majority

#mongodb+srv://mydesk_user:9975ragini@cluster0.evyncrq.mongodb.net/mydesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mydesk

# JWT Secret Key for signing authentication tokens
# Replace with a long, random secret string in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# ---------------------------------
# OnlineCompiler.io Code Execution Service (Phase 7.3)
# Free 100,000 runs/month - https://onlinecompiler.io
# ---------------------------------
ONLINECOMPILER_API_URL=https://api.onlinecompiler.io/api/judge0
# Configure your free OnlineCompiler.io API key privately in server/.env:
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key_here

# ---------------------------------
# GitHub OAuth Integration (Phase 8)
# Register OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:5000/api/github/callback
# ---------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
CLIENT_URL=http://localhost:5173

# Dedicated 256-bit (32-byte) secret for AES-256-GCM OAuth token encryption at rest (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here
