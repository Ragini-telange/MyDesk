# =================================================================
# MyDesk Backend Environment Variables Template
# Copy this file to .env in local development: cp .env.example .env
# In Render production, add these variables in the Render Dashboard.
# =================================================================

# 1. Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# 2. MongoDB Database Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/mydesk
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mydesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mydesk

# 3. JWT Authentication Secrets
# Generate a secure random string for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# 4. OnlineCompiler.io Code Execution Service (Phase 7.3)
# Register for a free API key at https://onlinecompiler.io
ONLINECOMPILER_API_URL=https://api.onlinecompiler.io/api/judge0
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key_here

# 5. GitHub OAuth Integration & Synchronization (Phase 8)
# Register a GitHub OAuth App at https://github.com/settings/developers
# - In local development:
#   Homepage URL: http://localhost:5173
#   Authorization callback URL: http://localhost:5000/api/github/callback
# - In production (Render + Vercel):
#   Homepage URL: https://your-frontend.vercel.app
#   Authorization callback URL: https://your-backend.onrender.com/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# 6. Frontend Client URL (For CORS & OAuth redirects)
# - In local development: http://localhost:5173
# - In production: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# 7. AES-256-GCM Encryption Key for GitHub Access Tokens at Rest
# Dedicated 256-bit (32-byte / 64-character hex) key
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here
